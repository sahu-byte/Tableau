      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesQuantity]) / TOTAL(SUM([SalesQuantity]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit' datatype='real' name='[Calculation_0158065953058819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([SalesAmount])-SUM([TotalCost])' />
      </column>
      <column caption='Markup Margin' datatype='real' name='[Calculation_0899961056514048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([SalesAmount])/SUM([TotalCost]))-1' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0899961059688449]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([SalesAmount])-SUM([TotalCost]))/SUM([SalesAmount]))' />
